generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

enum Role {
    USER
    ADMIN
    SUPERADMIN
    GUEST
}

enum Gender {
    MALE
    FEMALE
    OTHER
}

model User {
    id          String   @id
    email       String?  @unique
    isOnboarded Boolean  @default(false)
    role        Role     @default(USER)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    onboarding   Onboarding?
    devices      Device[]
    accessTokens AccessToken[]
    medications  Medication[]

    @@map("users")
}

model AccessToken {
    id        String   @id
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    token     String   @unique
    expiresAt DateTime
    createdAt DateTime @default(now())
    userAgent String?
    ipAddress String?

    @@map("access_tokens")
}

model Device {
    id          String      @id @unique @default(uuid())
    userId      String?
    user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
    isOnboarded Boolean     @default(false)
    onboarding  Onboarding?
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt
}

model Onboarding {
    id     String  @id @default(uuid())
    userId String? @unique
    user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

    deviceId String? @unique
    device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

    name              String
    birthday          String
    gender            Gender
    glp_medication    String
    glp_medication_on Boolean
    current_dose      String
    injection_device  String
    often_shots       String
    height            String
    current_weight    String
    current_goal      String
    weight_goal       String
    goal_duration     String
    frustrate_thing   String
    lifestyle         String
    protein_goal      String
    motivation        String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("onboardings")
}

model Medication {
    id        String   @id @default(uuid())
    name      String
    userId    String?
    user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("medications")
}

model InjectionLog {
    id        String @id @default(uuid())
    dosage    String
    date      String
    site      String
    painLevel String
    notes     String
}
