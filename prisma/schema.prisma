generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
    // directUrl = env("DIRECT_URL")
}

enum Role {
    USER
    ADMIN
    SUPERADMIN
    GUEST
}

enum Gender {
    MALE
    FEMALE
    OTHER
}

enum TokenType {
    ACCESS_TOKEN
    REFRESH_TOKEN
}

model User {
    id          String   @id
    email       String?  @unique
    name        String?
    birthday    String?
    gender      Gender?
    isAnonymous Boolean  @default(true)
    isOnboarded Boolean  @default(false)
    role        Role     @default(USER)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    provider    String?
    providerUid String?

    onboarding     Onboarding?
    devices        Device[]
    Tokens         Token[]
    medications    Medication[]
    injectionLogs  InjectionLog[]
    treatments     Treatment[]
    injectionShots InjectionShot[]

    @@map("users")
}

model Device {
    id             String          @id @unique
    userId         String?
    user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
    platform       String?
    isOnboarded    Boolean         @default(false)
    onboarding     Onboarding?
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
    injectionLogs  InjectionLog[]
    treatments     Treatment[]
    injectionShots InjectionShot[]
}

model Token {
    id        String    @id
    userId    String
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    token     String    @unique
    type      TokenType @default(ACCESS_TOKEN)
    expiresAt DateTime
    createdAt DateTime  @default(now())
    userAgent String?
    ipAddress String?

    @@map("access_tokens")
}

model Medication {
    id             String          @id @default(uuid())
    name           String
    userId         String?
    user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
    injectionLogs  InjectionLog[]
    injectionShots InjectionShot[]

    @@map("medications")
}

model Onboarding {
    id     String  @id @default(uuid())
    userId String? @unique
    user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

    deviceId String? @unique
    device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

    glp_medication_on Boolean

    height_cm Float?
    height_ft Int?
    height_in Int?

    current_weight_kg Float?
    current_weight_lb Float?
    weight_goal_kg    Float?
    weight_goal_lb    Float?

    goal_duration   String
    frustrate_thing String
    lifestyle       String
    protein_goal    String
    motivation      String[]

    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
    treatments     Treatment[]
    injectionShots InjectionShot[]

    @@map("onboardings")
}

model InjectionLog {
    id     String  @id @default(uuid())
    userId String?
    user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

    medicationId String?
    medication   Medication? @relation(fields: [medicationId], references: [id], onDelete: SetNull)

    deviceId String?
    device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

    date      DateTime
    dosage    String
    site      String
    painLevel Float    @default(0)
    notes     String?

    createdAt  DateTime    @default(now())
    updatedAt  DateTime    @updatedAt
    treatments Treatment[]

    @@map("injection_logs")
}

model Treatment {
    id     String  @id @default(uuid())
    userId String?
    user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

    deviceId String?
    device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

    lastInjectionId String?
    lastInjection   InjectionLog? @relation(fields: [lastInjectionId], references: [id], onDelete: SetNull)

    onboardingId String?
    onboarding   Onboarding? @relation(fields: [onboardingId], references: [id], onDelete: SetNull)

    injectionShotId String?
    injectionShot   InjectionShot? @relation(fields: [injectionShotId], references: [id], onDelete: SetNull)

    treatmentNotes String[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model InjectionShot {
    id String @id @default(uuid())

    userId String?
    user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

    deviceId String?
    device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

    onboardingId String?
    onboarding   Onboarding? @relation(fields: [onboardingId], references: [id], onDelete: SetNull)

    medicationId String?
    medication   Medication? @relation(fields: [medicationId], references: [id], onDelete: SetNull)

    current_dose     String
    injection_device String
    often_shots      Int

    Injectionsite String?

    currentStock Float @default(0.00)

    isFirstDose Boolean     @default(true)
    CreatedAt   DateTime    @default(now())
    treatments  Treatment[]
}
