generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
  GUEST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum TokenType {
  ACCESS_TOKEN
  REFRESH_TOKEN
  FAMILY_ACCESS_TOKEN
  FAMILY_REFRESH_TOKEN
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum FoodSource {
  MANUAL
  BARCODE
  AI_SCAN
}

enum ReminderCategory {
  INJECTION_SCHEDULE
  BREAKFAST
  LUNCH
  DINNER
  WATER
  STEPS
  WEIGHT
}

/**
 * ---------------------- USER & AUTH ----------------------
 */

model User {
  id          String   @id
  email       String?  @unique
  name        String?
  birthday    String?
  gender      Gender?
  isAnonymous Boolean  @default(true)
  isOnboarded Boolean  @default(false)
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider    String?
  providerUid String?

  hasSubscription Boolean @default(false)

  remindersEnabled Boolean @default(true)

  members Family[]

  onboarding     Onboarding?
  devices        Device[]
  Tokens         Token[]
  medications    Medication[]
  injectionLogs  InjectionLog[]
  treatments     Treatment[]
  injectionShots InjectionShot[]

  foods              Food[]
  meals              Meal[]
  userFoods          UserFood[]
  quickAdds          QuickAdd[]
  foodLogs           FoodLog[]
  weightlogs         weightlog[]
  sideEffects        SideEffect[]
  sideEffectLogs     SideEffectLog[]
  waterLogs          WaterLog[]
  nextInjectionShots NextInjectionShot[]
  walkingStepsLogs   WalkingStepsLog[]
  dashboards         Dashboard[]
  heights            Height[]
  photos             Photo[]
  invitations        Invitation[]
  pairingCodes       PairingCode[]
  permissions        Permission[]
  fcmTokens          FcmToken[]

  receivedNotifications Notification[]         @relation("ReceivedNotifications")
  userPlan              UserPlan?
  notificationReminders NotificationReminder[]
  subscriptions         Subscription[]
  chatSessions          ChatSession[]
  coachConfig           CoachConfig?
  payments              Payment[]
  apiKeys               ApiKey[]
  tokenCounts           TokenCount[]

  @@map("users")
}

model Device {
  id          String      @id @unique
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform    String?
  isOnboarded Boolean     @default(false)
  onboarding  Onboarding?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  injectionLogs  InjectionLog[]
  treatments     Treatment[]
  injectionShots InjectionShot[]

  foods      Food[]
  meals      Meal[]
  userFoods  UserFood[]
  quickAdds  QuickAdd[]
  foodLogs   FoodLog[]
  weightlogs weightlog[]

  sideEffects    SideEffect[]
  sideEffectLogs SideEffectLog[]

  waterLogs             WaterLog[]
  nextInjectionShots    NextInjectionShot[]
  walkingStepsLogs      WalkingStepsLog[]
  dashboards            Dashboard[]
  heights               Height[]
  photos                Photo[]
  families              Family[]
  fcmTokens             FcmToken[]
  notifications         Notification[]         @relation("ReceivedNotifications")
  userPlans             UserPlan[]
  notificationReminders NotificationReminder[]
  subscriptions         Subscription[]
  payments              Payment[]
  tokenCounts           TokenCount[]
}

model Token {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  type      TokenType @default(ACCESS_TOKEN)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  @@map("access_tokens")
}

model UserPlan {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  energy   Float?
  calories Float?
  protein  Float?
  carbs    Float?
  fat      Float?
  fiber    Float?

  stepsTarget   Int?
  waterTargetMl Float? @default(3000)

  nextInjectionShotId String?
  nextInjectionShot   NextInjectionShot? @relation(fields: [nextInjectionShotId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_plans")
}

model FcmToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  fcmToken String @unique

  notification   Notification? @relation(fields: [notificationId], references: [id])
  notificationId String?

  @@map("fcm_tokens")
}

model NotificationReminder {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  category  ReminderCategory
  isEnabled Boolean          @default(true)

  cronTime String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_reminders")
}

model Notification {
  id        String    @id @default(uuid())
  type      String?
  title     String
  body      String
  data      Json?
  image     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  senderFamilyId String?
  senderFamily   Family? @relation(fields: [senderFamilyId], references: [id], onDelete: SetNull)

  recipientId String
  recipient   User   @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation("ReceivedNotifications", fields: [deviceId], references: [id], onDelete: SetNull)

  deliveredTo FcmToken[]

  @@map("noticifications")
}

/**
 * ---------------------- MEDICATIONS ----------------------
 */

model Medication {
  id     String  @id @default(uuid())
  name   String
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  doseMg             Float? // default dose (optional)
  halfLifeHours      Float? // required for exponential decay
  absorptionRateKa   Float? // optional, only if using ka model
  bioavailability    Float? // optional (0–1)
  volumeDistribution Float? // optional (L or L/kg)

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  injectionLogs      InjectionLog[]
  injectionShots     InjectionShot[]
  nextInjectionShots NextInjectionShot[]

  @@map("medications")
}

model Onboarding {
  id     String  @id @default(uuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String? @unique
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  glp_medication_on Boolean

  height_cm Float?
  height_ft Int?
  height_in Int?

  current_weight_kg Float?
  current_weight_lb Float?
  weight_goal_kg    Float?
  weight_goal_lb    Float?

  goal_duration   String
  frustrate_thing String
  lifestyle       String
  protein_goal    String
  motivation      String[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  treatments     Treatment[]
  injectionShots InjectionShot[]

  @@map("onboardings")
}

model InjectionLog {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  medicationId String?
  medication   Medication? @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  date      DateTime
  dosage    String
  site      String
  painLevel Float    @default(0)
  notes     String?

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  treatments Treatment[]

  @@map("injection_logs")
}

model NextInjectionShot {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  medicationId String?
  medication   Medication? @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  dose             String
  injection_device String

  Injectionsite String?

  notified Boolean @default(false)

  Date DateTime

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userPlans UserPlan[]

  @@map("next_injections")
}

model Treatment {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  lastInjectionId String?
  lastInjection   InjectionLog? @relation(fields: [lastInjectionId], references: [id], onDelete: SetNull)

  onboardingId String?
  onboarding   Onboarding? @relation(fields: [onboardingId], references: [id], onDelete: SetNull)

  injectionShotId String?
  injectionShot   InjectionShot? @relation(fields: [injectionShotId], references: [id], onDelete: SetNull)

  treatmentNotes String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InjectionShot {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  onboardingId String?
  onboarding   Onboarding? @relation(fields: [onboardingId], references: [id], onDelete: SetNull)

  medicationId String?
  medication   Medication? @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  current_dose     String
  injection_device String
  often_shots      Int

  Injectionsite String?

  currentStock Float @default(0.00)

  isFirstDose Boolean     @default(true)
  CreatedAt   DateTime    @default(now())
  treatments  Treatment[]
}

/**
 * ---------------------- FOODS ----------------------
 */

model Food {
  id   String @id @default(uuid())
  name String

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  dataPerAmount Float?  @default(100)
  dataPerUnit   String? @default("g")

  macros    Macro[]       @relation("FoodMacros")
  mealFoods MealFood[]
  foodLogs  FoodLogItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("foods")
}

model UserFood {
  id   String @id @default(uuid())
  name String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  FoodSource FoodSource

  servingSize Float?
  servingUnit String?

  alternativeServingSizes String[]
  alternativeServingUnits String[]

  macros    Macro[]       @relation("UserFoodMacros")
  mealFoods MealFood[]
  foodLogs  FoodLogItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_foods")
}

model QuickAdd {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  mealType MealType
  loggedAt DateTime

  macros Macro[] @relation("QuickAddMacros")

  foodLogs FoodLogItem[]

  createdAt DateTime   @default(now())
  mealFoods MealFood[]

  @@map("quick_adds")
}

/**
 * ---------------------- MACROS ----------------------
 */

model Macro {
  id String @id @default(uuid())

  energy   Float?
  calories Float?
  protein  Float?
  carbs    Float?
  fat      Float?
  fiber    Float?

  foodId String?
  food   Food?   @relation("FoodMacros", fields: [foodId], references: [id], onDelete: Cascade)

  userFoodId String?
  userFood   UserFood? @relation("UserFoodMacros", fields: [userFoodId], references: [id], onDelete: Cascade)

  quickAddId String?
  quickAdd   QuickAdd? @relation("QuickAddMacros", fields: [quickAddId], references: [id], onDelete: Cascade)

  foodLogItemId String?
  foodLogItem   FoodLogItem? @relation("FoodLogItemMacros", fields: [foodLogItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("macros")
}

/**
 * ---------------------- MEALS ----------------------
 */

model Meal {
  id   String @id @default(uuid())
  name String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  mealType MealType

  foods    MealFood[]
  foodLogs FoodLogItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("meals")
}

model MealFood {
  id     String @id @default(uuid())
  mealId String
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  foodId String?
  food   Food?   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  userFoodId String?
  userFood   UserFood? @relation(fields: [userFoodId], references: [id], onDelete: Cascade)

  quickAddId String?
  quickAdd   QuickAdd? @relation(fields: [quickAddId], references: [id], onDelete: Cascade)

  quantity Float

  @@map("meal_foods")
}

/**
 * ---------------------- FOOD LOGGING (FIXED) ----------------------
 */

model FoodLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  mealType MealType
  loggedAt DateTime @default(now())

  items FoodLogItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("food_logs")
}

model FoodLogItem {
  id String @id @default(uuid())

  logId String
  log   FoodLog @relation(fields: [logId], references: [id], onDelete: Cascade)

  foodId String?
  food   Food?   @relation(fields: [foodId], references: [id], onDelete: SetNull)

  userFoodId String?
  userFood   UserFood? @relation(fields: [userFoodId], references: [id], onDelete: SetNull)

  mealId String?
  meal   Meal?   @relation(fields: [mealId], references: [id], onDelete: SetNull)

  quickAddId String?
  quickAdd   QuickAdd? @relation(fields: [quickAddId], references: [id], onDelete: SetNull)

  quantity Float
  unit     String

  macros Macro[] @relation("FoodLogItemMacros")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("food_log_items")
}

// -------------------Water log -------------------
model WaterLog {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId       String?
  device         Device?         @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  date           DateTime        @default(now())
  targets        Float[]
  targetInMl     Float?          @default(3000)
  totalConsumed  Float           @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  consumedWaters ConsumedWater[]

  @@map("water_logs")
}

model ConsumedWater {
  id         String   @id @default(uuid())
  consumedAt DateTime
  consumedML Float?
  consumedOZ Float?
  waterLogId String
  waterLog   WaterLog @relation(fields: [waterLogId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("consumed_waters")
}

// -------------------Weight log -------------------
model weightlog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  date              DateTime @default(now())
  current_weight_kg Float?
  current_weight_lb Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("weight_logs")
}

// -------------------Side effects -------------------
model SideEffect {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs SideEffectLog[] @relation("SideEffectToLogs")

  @@map("side_effects")
}

model SideEffectLog {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  date DateTime @default(now())

  sideEffects SideEffect[] @relation("SideEffectToLogs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("side_effect_logs")
}

//------------------- Walking Steps Log -------------------
model WalkingStepsLog {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  date DateTime @default(now())

  NumberOfSteps Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("walking_steps_logs")
}

// ------------------- Dashboard New Fields -------------------
model Dashboard {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  feeling Int?

  estimatedLevel Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dashboards")
}

model Height {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  height_cm Float?
  height_ft Int?
  height_in Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("heights")
}

model Photo {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  photoUrl String

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("photos")
}

model Family {
  id String @id @default(uuid())

  name         String
  dob          DateTime?
  relationship String?

  permissions Permission[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)
  accepted Boolean @default(false)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  pairingCodes  PairingCode[]
  notifications Notification[]

  @@map("families")
}

model PairingCode {
  id       String @id @default(uuid())
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  code      String
  expiresAt DateTime
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([code])
  @@map("family_pairing_codes")
}

model Invitation {
  id String @id @default(uuid())

  token String @unique

  invitedById String
  invitedBy   User   @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  expiresAt  DateTime?
  consumed   Boolean   @default(false)
  consumedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions Permission[]

  @@map("family_invitations")
}

model Permission {
  id        String   @id @default(uuid())
  name      String
  slug      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  invitations Invitation[]
  families    Family[]
}

model Subscription {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  revenueCatUserId String    @unique // App user ID used in RevenueCat
  entitlement      String // "metab_pro"
  productId        String // monthly / yearly / lifetime  
  isActive         Boolean   @default(false)
  renewsAt         DateTime?
  expiresAt        DateTime?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  device       Device?       @relation(fields: [deviceId], references: [id])
  deviceId     String?
  chatSessions ChatSession[]
  payments     Payment[]
  tokenCounts  TokenCount[]

  @@map("subscriptions")
}

model ApiKey {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  key       String    @unique
  provider  String
  tokens    Int?
  expiresAt DateTime?

  isDisabled Boolean @default(false)
  disabledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("api_keys")
}

// this is used to track the number of tokens used for chats ai coach
model TokenCount {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  count Int @default(0)

  limit Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("token_count")
}

model ChatSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title      String?
  tokensUsed Int     @default(0)

  messages ChatMessage[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?

  @@map("coach_chat_sessions")
}

model ChatMessage {
  id String @id @default(uuid())

  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  isUser  Boolean
  content String

  tokenCount Int @default(0)

  createdAt DateTime @default(now())

  @@map("coach_chat_messages")
}

model CoachConfig {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tone           String? // "friendly", "professional", etc.
  goalsEnabled   Boolean @default(true)
  nutritionFocus Boolean @default(true)
  exerciseFocus  Boolean @default(true)
  mentalFocus    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coach_config")
}

model Payment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  amount                Float
  currency              String
  notes                 String?
  stripePaymentIntentId String?

  status String? @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}
